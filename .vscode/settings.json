{
    "files.associations": {
        "_headers": "plaintext",
        "_redirects": "plaintext",
    },
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nil",
    "nix.serverSettings": {
        "nil": {
            "formatting": {
                "command": [
                    "nixfmt"
                ],
            },
        },
    }
}