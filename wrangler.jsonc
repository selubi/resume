// wrangler.jsonc
{
	"$schema": ".devenv.files/wrangler-schema.json",
	"name": "resume",
	"compatibility_date": "2026-10-06",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist"
	},
	"routes": [
		{
			"pattern": "resume.selubi.com",
			"custom_domain": true
		},
		{
			"pattern": "cv.selubi.com",
			"custom_domain": true
		},
		{
			"pattern": "resume.selubi.tech",
			"custom_domain": true
		},
		{
			"pattern": "cv.selubi.tech",
			"custom_domain": true
		}
	]
}
// https://developers.cloudflare.com/workers/wrangler/configuration/